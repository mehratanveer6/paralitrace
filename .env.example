# Paste your keys after the = signs, save, and close. All three are free.
# This file stays on your computer: .env is never committed to git.

# Assistant (Ask tab): aistudio.google.com/apikey
GEMINI_API_KEY=

# Backtest fires: firms.modaps.eosdis.nasa.gov/api/map_key (the key arrives by email)
FIRMS_MAP_KEY=

# Backtest monitors: sign up at explore.openaq.org, the key is in your account settings
OPENAQ_API_KEY=

# Optional: force a model provider (gemini, anthropic, ollama, bedrock) or a Gemini model
# PT_MODEL=
# GEMINI_MODEL=
